@@ -8669,0 +8670,16 @@
+  bool AuthenticatesNullValues = false;
+  if (Attr.getNumArgs() == 4) {
+    Expr *OptionsExpr = Attr.getArgAsExpr(3)->IgnoreParenImpCasts();
+    const auto *Options = dyn_cast<StringLiteral>(OptionsExpr);
+    // The XNU ABI needs this option. Reject unimplemented modes instead of
+    // accepting their spelling while silently retaining another signing policy.
+    if (!Options || !Options->isOrdinary() ||
+        Options->getString() != "authenticates-null-values") {
+      S.Diag(OptionsExpr->getExprLoc(), diag::err_ptrauth_auth_null_option)
+          << OptionsExpr->getSourceRange();
+      Attr.setInvalid();
+      return;
+    }
+    AuthenticatesNullValues = true;
+  }
+
@@ -8713 +8729 @@
