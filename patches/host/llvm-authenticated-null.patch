diff --git a/clang/lib/CodeGen/CGPointerAuth.cpp b/clang/lib/CodeGen/CGPointerAuth.cpp
--- a/clang/lib/CodeGen/CGPointerAuth.cpp
+++ b/clang/lib/CodeGen/CGPointerAuth.cpp
@@ -373 +373,4 @@
-  if (Value == Null)
+  bool HasSignedNull =
+      (CurAuthInfo && CurAuthInfo.authenticatesNullValues()) ||
+      (NewAuthInfo && NewAuthInfo.authenticatesNullValues());
+  if (Value == Null && !HasSignedNull)
@@ -387,0 +391,37 @@
+  if (HasSignedNull) {
+    // A signed-null policy cannot use the legacy raw-zero shortcut. Convert
+    // through the raw value, applying each policy's null rule independently.
+    // This also handles transfers between ordinary nullable and signed-null
+    // storage, including address-discriminated structure copies.
+    auto Transform = [&](llvm::Value *Input, const CGPointerAuthInfo &Info,
+                         bool Sign) -> llvm::Value * {
+      auto Emit = [&](llvm::Value *Pointer) {
+        return Sign ? EmitPointerAuthSign(Info, Pointer)
+                    : EmitPointerAuthAuth(Info, Pointer);
+      };
+      if (Info.authenticatesNullValues() ||
+          llvm::isKnownNonZero(Input, CGM.getDataLayout()))
+        return Emit(Input);
+      if (Input == Null)
+        return Input;
+
+      llvm::BasicBlock *InitBB = Builder.GetInsertBlock();
+      llvm::BasicBlock *NonNullBB = createBasicBlock("ptrauth.nonnull");
+      llvm::BasicBlock *ContBB = createBasicBlock("ptrauth.cont");
+      Builder.CreateCondBr(Builder.CreateICmpNE(Input, Null), NonNullBB, ContBB);
+      EmitBlock(NonNullBB);
+      llvm::Value *Converted = Emit(Input);
+      llvm::BasicBlock *ConvertedBB = Builder.GetInsertBlock();
+      EmitBlock(ContBB);
+      auto *Phi = Builder.CreatePHI(Input->getType(), 2);
+      Phi->addIncoming(Null, InitBB);
+      Phi->addIncoming(Converted, ConvertedBB);
+      return Phi;
+    };
+    if (CurAuthInfo)
+      Value = Transform(Value, CurAuthInfo, /*Sign=*/false);
+    if (NewAuthInfo)
+      Value = Transform(Value, NewAuthInfo, /*Sign=*/true);
+    return Value;
+  }
+
