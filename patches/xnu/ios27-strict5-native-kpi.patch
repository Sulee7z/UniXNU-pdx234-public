diff --git a/iokit/Kernel/IOUserServer.cpp b/iokit/Kernel/IOUserServer.cpp
--- a/iokit/Kernel/IOUserServer.cpp
+++ b/iokit/Kernel/IOUserServer.cpp
@@ -7750,6 +7750,56 @@
 	return ret;
 }
 
+/* The handler returned by IOUserPlatformFunction uses dictionary arguments. */
+typedef IOReturn (*IOUserPlatformFunctionHandler)(IOService *, const OSSymbol *,
+    bool, OSDictionary *, OSDictionary **);
+
+kern_return_t
+IOService::CallPlatformFunction_Impl(OSString * functionName, bool waitForFunction,
+    OSDictionary * input, OSDictionary ** output)
+{
+	if (!functionName || !output) {
+		return kIOReturnBadArgument;
+	}
+	*output = NULL;
+	task_t task = current_task();
+	if (!task || !task_is_driver(task)) {
+		return kIOReturnUnsupported;
+	}
+	if (reserved && reserved->uvars && reserved->uvars->userServer &&
+	    reserved->uvars->userServer->fOwningTask != task) {
+		return CallPlatformFunction(functionName, waitForFunction, input, output, NULL);
+	}
+
+	const OSSymbol * query = OSSymbol::withCStringNoCopy("IOUserPlatformFunction");
+	if (!query) {
+		return kIOReturnNoMemory;
+	}
+	IOUserPlatformFunctionHandler handler = NULL;
+	IOReturn ret = callPlatformFunction(query, true, &handler, NULL, NULL, NULL);
+	query->release();
+	if (ret != kIOReturnSuccess || !handler) {
+		return kIOReturnUnsupported;
+	}
+	/* A raw six-argument platform method is not an authorized V2 handler. */
+	typedef IOReturn (IOService::*RawMethod)(const OSSymbol *, bool,
+	    void *, void *, void *, void *);
+	IOUserPlatformFunctionHandler raw = OSMemberFunctionCast(IOUserPlatformFunctionHandler,
+	    this, static_cast<RawMethod>(&IOService::callPlatformFunction));
+	if (handler == raw) {
+		IOLog("callPlatformFunction disallowed for user platform function: service %s, 0x%llx\n",
+		    getName(), getRegistryEntryID());
+		return kIOReturnUnsupported;
+	}
+	const OSSymbol * name = OSSymbol::withString(functionName);
+	if (!name) {
+		return kIOReturnNoMemory;
+	}
+	ret = handler(this, name, waitForFunction, input, output);
+	name->release();
+	return ret;
+}
