+#if CODE_SIGNING_MONITOR
+#error "Image4 V2 native compatibility requires the no-monitor configuration"
+#endif
+
+/* These exports report an absent monitor, never a successful policy update. */
+errno_t image4_v2_set_nonce_digest(uint32_t domain, const void *digest, size_t length);
+errno_t image4_v2_roll_nonce(uint32_t domain);
+errno_t image4_v2_load_diavlo_root_ca(const void *payload, size_t payload_length,
+    const void *manifest, size_t manifest_length);
+errno_t image4_v2_load_local_policy(const void *policy, size_t length);
 
 void image4_v2_interface_register(const void *interface);
 
@@ -21,3 +35,41 @@
 	}
 	_image4_v2_interface = interface;
 }
+
+errno_t
+image4_v2_set_nonce_digest(uint32_t domain, const void *digest, size_t length)
+{
+	(void)digest;
+	printf("image4_v2: nonce digest registration has no monitor: %u | %lu\n",
+	    domain, length);
+	return ENOTSUP;
+}
+
+errno_t
+image4_v2_roll_nonce(uint32_t domain)
+{
+	printf("image4_v2: monitor nonce roll unavailable: %u\n", domain);
+	return ENOTSUP;
+}
+
+errno_t
+image4_v2_load_diavlo_root_ca(const void *payload, size_t payload_length,
+    const void *manifest, size_t manifest_length)
+{
+	/* Preserve the D27 V2 caller's validation result; it is not BSD EINVAL. */
+	if (!payload || !payload_length || !manifest || !manifest_length) {
+		return 3;
+	}
+	printf("image4_v2: Diavlo Root CA loading has no monitor\n");
+	return ENOTSUP;
+}
+
+errno_t
+image4_v2_load_local_policy(const void *policy, size_t length)
+{
+	if (!policy || !length) {
+		return 3;
+	}
+	printf("image4_v2: local policy loading has no monitor\n");
+	return ENOTSUP;
+}
