diff --git a/bsd/sys/d27_spawn_wire.h b/bsd/sys/d27_spawn_wire.h
new file mode 100644
--- /dev/null
+++ b/bsd/sys/d27_spawn_wire.h
@@ -0,0 +1,53 @@
+#ifndef _SYS_D27_SPAWN_WIRE_H_
+#define _SYS_D27_SPAWN_WIRE_H_
+
+/* D27/24A446 user ABI, independently recovered from the original library
+ * setters and kernel copyin. Not an offset overlay on native spawnattr.
+ * Include after spawn_internal.h, with memcpy/memset and errno available.
+ */
+struct d27_spawn_wire_prefix {
+	uint8_t common_through_launch_type[169];
+	uint8_t padding_before_policy[3];
+	uint32_t policy_raw;
+	uint8_t sanitizer_options;
+	uint8_t padding_after_sanitizer[3];
+	uint32_t crash_count;
+	uint32_t throttle_timeout;
+	uint32_t kqworkloop_soft_limit;
+	uint32_t kqworkloop_hard_limit;
+	uint32_t conclave_mem_limit;
+};
+_Static_assert(sizeof(struct d27_spawn_wire_prefix) == 200, "D27 copyin prefix");
+_Static_assert(offsetof(struct d27_spawn_wire_prefix, policy_raw) == 172, "D27 policy");
+_Static_assert(offsetof(struct d27_spawn_wire_prefix, sanitizer_options) == 176, "D27 sanitizer");
+_Static_assert(offsetof(struct _posix_spawnattr, psa_launch_type) == 168, "native launch type");
+_Static_assert(offsetof(struct _posix_spawnattr, psa_d27_sanitizer_options) == 169, "native padding byte");
+_Static_assert(offsetof(struct _posix_spawnattr, psa_sec_flags) == 170, "native security flags");
+_Static_assert(offsetof(struct _posix_spawnattr, psa_ports) == 192, "native extension boundary");
+
+static inline int
+d27_spawn_translate_prefix(const struct d27_spawn_wire_prefix *wire,
+    struct _posix_spawnattr *native)
+{
+	/* Original rejects all bits outside 0x1f01. The remaining nonzero values
+	 * require a separate semantic policy mapping; do not truncate them into
+	 * the older native sec_flags. This adapter currently supports policy=0.
+	 */
+	if (wire->policy_raw & ~UINT32_C(0x1f01)) {
+		return EINVAL;
+	}
+	if (wire->policy_raw != 0) {
+		return ENOTSUP;
+	}
+	memset(native, 0, sizeof(*native));
+	memcpy(native, wire->common_through_launch_type,
+	    sizeof(wire->common_through_launch_type));
+	native->psa_d27_sanitizer_options = wire->sanitizer_options;
+	native->psa_crash_count = wire->crash_count;
+	native->psa_throttle_timeout = wire->throttle_timeout;
+	native->psa_kqworkloop_soft_limit = wire->kqworkloop_soft_limit;
+	native->psa_kqworkloop_hard_limit = wire->kqworkloop_hard_limit;
+	native->psa_conclave_mem_limit = wire->conclave_mem_limit;
+	return 0;
+}
+#endif
