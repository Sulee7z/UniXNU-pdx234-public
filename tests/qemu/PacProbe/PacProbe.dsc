[Defines]
  PLATFORM_NAME = PdxQemuPacProbe
  PLATFORM_GUID = 3D2F654A-AE45-4F89-9980-70D84E8EE6DC
  PLATFORM_VERSION = 0.1
  DSC_SPECIFICATION = 0x0001001C
  OUTPUT_DIRECTORY = Build/PdxQemuPacProbe
  SUPPORTED_ARCHITECTURES = AARCH64
